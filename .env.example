# dashboard-api (FastAPI, reads Supabase's dashboard_cache) base URL.
# When set, this takes priority over VITE_GAS_API_URL below.
VITE_API_BASE_URL=http://localhost:8000

# Deploy the Apps Script as a JSON API and paste its /exec URL here.
# Used only when VITE_API_BASE_URL is unset - direct-to-Sheets fallback.
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_DATA_CACHE_MINUTES=10
